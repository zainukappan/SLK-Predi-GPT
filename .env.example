# Credential-free local mode (never deploy with this enabled)
SBK_LOCAL_DEMO=true
APP_ORIGIN=http://localhost:3000
# Production: set SBK_LOCAL_DEMO=false and configure all below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key, required for organizer-created accounts.
SUPABASE_SECRET_KEY=
# Dedicated sbk_app role connection; NEVER use the database owner here.
DATABASE_URL=
# Optional PEM root CA for hosted environments (no local filesystem path).
DATABASE_SSL_CA=
# Put owner migration credentials in a SEPARATE .env.migration file; see README.
